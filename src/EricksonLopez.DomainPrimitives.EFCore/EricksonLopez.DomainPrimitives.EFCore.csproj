<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.DomainPrimitives.EFCore</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives.EFCore</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DomainPrimitives.EFCore</PackageId>
    <Description>EF Core integration for EricksonLopez.DomainPrimitives. Automatically generates NativeAOT-ready ValueConverters for all domain primitives without reflection.</Description>
    <PackageTags>$(PackageTags);efcore;entity-framework-core;orm</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.Abstractions\EricksonLopez.DomainPrimitives.Abstractions.csproj" />
    <!-- Reference the Source Generator so it gets packed with this meta-package as an analyzer -->
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.EFCore.SourceGenerators\EricksonLopez.DomainPrimitives.EFCore.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    
  </ItemGroup>
</Project>






