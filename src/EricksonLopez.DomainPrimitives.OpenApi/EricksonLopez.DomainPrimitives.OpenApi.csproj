<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.DomainPrimitives.OpenApi</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives.OpenApi</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DomainPrimitives.OpenApi</PackageId>
    <Description>OpenAPI/Swashbuckle integration for EricksonLopez.DomainPrimitives. Generates precise schema specifications for domain primitives.</Description>
    <PackageTags>$(PackageTags);openapi;swagger;swashbuckle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.Abstractions\EricksonLopez.DomainPrimitives.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.OpenApi.SourceGenerators\EricksonLopez.DomainPrimitives.OpenApi.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>    <DelaySign>false</DelaySign>
  </PropertyGroup>
</Project>








