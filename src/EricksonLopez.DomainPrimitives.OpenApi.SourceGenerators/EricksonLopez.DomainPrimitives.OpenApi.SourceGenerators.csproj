<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>EricksonLopez.DomainPrimitives.OpenApi.SourceGenerators</PackageId>
    <Description>Source Generators for OpenApi integration with EricksonLopez.DomainPrimitives.</Description>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>    <DelaySign>false</DelaySign>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.DomainPrimitives.OpenApi.SourceGenerators.Tests, " />
  </ItemGroup>
</Project>


