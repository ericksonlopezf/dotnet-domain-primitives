<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PublishAot>false</PublishAot>
    <AssemblyName>EricksonLopez.DomainPrimitives.Generators</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives.Generators</RootNamespace>
    <LangVersion>14</LangVersion>

    <!-- Source Generator requirements -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>

    <!-- Do NOT set IsAotCompatible â€” generators run at compile time only -->
    <IsTrimmable>false</IsTrimmable>

    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DomainPrimitives.Generators</PackageId>
    <Description>Incremental Source Generators for EricksonLopez.DomainPrimitives. Generates complete domain primitive implementations at compile time: factory methods, parsing, formatting, equality, operators, and validation. Zero runtime footprint.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Suppress nullable warnings for netstandard2.0 -->
    <Nullable>enable</Nullable>
    <NoWarn>CS1591;$(NoWarn)</NoWarn>
    <PackageTags>$(PackageTags);source-generators;roslyn</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.DomainPrimitives.SourceGenerators.Tests, " />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
      </ItemGroup>

</Project>





