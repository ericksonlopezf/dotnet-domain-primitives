<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.DomainPrimitives.AspNetCore</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives.AspNetCore</RootNamespace>

    <IsPackable>true</IsPackable>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <PackageId>EricksonLopez.DomainPrimitives.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for EricksonLopez.DomainPrimitives. Automatically generates ModelBinders and Swagger/OpenAPI schemas for Domain Primitives.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the Source Generator so it gets packed with this meta-package as an analyzer -->
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.AspNetCore.SourceGenerators\EricksonLopez.DomainPrimitives.AspNetCore.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    
  </ItemGroup>
</Project>




