<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.DomainPrimitives.NewtonsoftJson</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives.NewtonsoftJson</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DomainPrimitives.NewtonsoftJson</PackageId>
    <Description>[LEGACY COMPATIBILITY] Newtonsoft.Json (Json.NET) converters and contract resolver for EricksonLopez.DomainPrimitives. Note: Newtonsoft.Json uses heavy runtime reflection and is not NativeAOT or trimming compatible.</Description>
    <NoWarn>$(NoWarn);CS8002;RS0016;RS0017;RS0036;RS0037</NoWarn>
    <PackageTags>$(CommonPackageTags);newtonsoft-json;json-net;json;serialization;json-converter;contract-resolver</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.DomainPrimitives.Abstractions\EricksonLopez.DomainPrimitives.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.DomainPrimitives.NewtonsoftJson.Tests, " />
  </ItemGroup>

</Project>
