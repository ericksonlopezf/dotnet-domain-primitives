<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <NoWarn>CA1805;CA1711;CA1000;CS1574</NoWarn>
    <AssemblyName>EricksonLopez.DomainPrimitives.Abstractions</AssemblyName>
    <RootNamespace>EricksonLopez.DomainPrimitives</RootNamespace>
    <!-- NativeAOT and trimming compatibility -->
    <PackageTags>$(CommonPackageTags);abstractions;attributes;contracts;value-object;strongly-typed-id;smart-enum;validation;native-aot</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- In netstandard2.0, static abstract interface members and span extensions are omitted -->
    <NoWarn>$(NoWarn);RS0017</NoWarn>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <Target Name="_ResetPublishAotOnNetStandard" BeforeTargets="ProcessFrameworkReferences;_CheckForUnsupportedNETCoreVersion" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PropertyGroup>
      <PublishAot>false</PublishAot>
      <PublishTrimmed>false</PublishTrimmed>
      <IsAotCompatible>false</IsAotCompatible>
      <IsTrimmable>false</IsTrimmable>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.DomainPrimitives.Abstractions</PackageId>
    <Description>Core abstractions for domain primitives: marker interfaces, type declaration attributes, validation attributes, and normalization attributes. Zero dependencies — pure attributes and interfaces only. NativeAOT and trimming compatible.</Description>
  </PropertyGroup>
  <!-- MED-006: DiagnosticSource removed from Abstractions — Diagnostics types moved to Core per TD-009.
       Abstractions now contains ONLY: attributes, marker interfaces, and PrimitiveError.
       No transitive dependencies on System.Diagnostics.DiagnosticSource or System.Diagnostics.Metrics. -->
  <ItemGroup>
      </ItemGroup>
    <!-- Removed EricksonLopez.Result dependency -->
</Project>
