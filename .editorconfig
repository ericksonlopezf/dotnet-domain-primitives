# Top-most EditorConfig file for dotnet-domain-primitives
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
# ── File Header Enforcement ──────────────────────────────────────────────────
file_header_template = Copyright © Erickson Lopez. MIT License.

# ── Code Style & Directives ──────────────────────────────────────────────────
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_namespace_declarations = file_scoped:warning

# ── Quality & Obsolete Enforcement (Zero-Tolerance) ──────────────────────────
dotnet_diagnostic.CS0618.severity = error
dotnet_diagnostic.CS0619.severity = error
dotnet_diagnostic.CS1591.severity = error
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.xUnit1051.severity = suggestion

# ── Zero-Allocation Policy on Result types ──────────────────────────────────
dotnet_diagnostic.BANNED_RESULT_TYPE.severity = error
dotnet_diagnostic.BANNED_RESULT_TYPE.message = "Do not use Result<T> for validation returns. Use bool Try... with out parameter instead to avoid heap allocations."
dotnet_diagnostic.BANNED_RESULT_TYPE.match = "Result<"

# ── Production Naming Rules ──────────────────────────────────────────────────
dotnet_naming_rule.types_must_be_pascal_case.symbols = types
dotnet_naming_rule.types_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_must_be_pascal_case.severity = warning

dotnet_naming_rule.interfaces_must_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_start_with_i.style = i_pascal_case
dotnet_naming_rule.interfaces_must_start_with_i.severity = warning

dotnet_naming_rule.methods_must_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.methods_must_be_pascal_case.severity = warning

dotnet_naming_rule.properties_must_be_pascal_case.symbols = properties
dotnet_naming_rule.properties_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.properties_must_be_pascal_case.severity = warning

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.properties.applicable_kinds = property

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

# ── Production Source Library Scope ──────────────────────────────────────────
[src/**/*.cs]
dotnet_diagnostic.CA1305.severity = warning

# ── Tests & Specifications (Living Documentation) ───────────────────────────
[tests/**/*.cs]
# ADR-037: Osherove naming pattern (Method_Scenario_Result) in test suites.
# Test methods are executable specifications where underscores denote test boundaries.
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CS1591.severity = none
csharp_style_namespace_declarations = file_scoped:suggestion

[samples/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.CA1305.severity = none
csharp_style_namespace_declarations = file_scoped:suggestion

[benchmarks/**/*.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CA1852.severity = none
csharp_style_namespace_declarations = file_scoped:suggestion

[*.txt]
dotnet_diagnostic.RS0024.severity = none
