<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EricksonLopez.DomainPrimitives.AotSmokeTest</RootNamespace>
    <AssemblyName>EricksonLopez.DomainPrimitives.AotSmokeTest</AssemblyName>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <TrimmerRootDescriptor>RootDescriptor.xml</TrimmerRootDescriptor>
    <IsPublishable>true</IsPublishable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.DomainPrimitives.Abstractions\EricksonLopez.DomainPrimitives.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.DomainPrimitives\EricksonLopez.DomainPrimitives.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.DomainPrimitives.Generators\EricksonLopez.DomainPrimitives.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
